{
  "name": "visionvault-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "VisionVault Desktop Application & File Teleportation Engine",
  "author": "VisionVault",
  "main": "src/main/index.js",
  "type": "module",
  "scripts": {
    "vite": "vite --port 5174",
    "electron": "wait-on http://localhost:5174 && electron .",
    "dev": "concurrently -k \"npm run vite\" \"npm run electron\"",
    "build": "vite build && electron-builder",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "clsx": "^2.1.1",
    "firebase": "^10.12.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^30.0.6",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.11",
    "wait-on": "^7.2.0"
  }
}
