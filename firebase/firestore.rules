rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile rule
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Legacy subcollection device rule
      match /devices/{deviceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Top-level Devices collection rule
    match /devices/{deviceId} {
      allow read, update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
    }

    // Files metadata collection rule
    match /files/{fileId} {
      allow read, update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
    }

    // Teleport jobs collection rule
    match /teleportJobs/{jobId} {
      allow read, update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
    }

    // Computer Vision results collection rule
    match /cvResults/{resultId} {
      allow read, update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
    }

    // Activity Logs collection rule
    match /activityLogs/{logId} {
      allow read, update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
    }
  }
}
